FROM docker.io/node:24.22.1-alpine AS npm

# load is installed straight from github
RUN apk add --no-cache git

COPY ./wwwroot/src/package.json ./wwwroot/src/package-lock.json /src/

RUN set -exu \
  && cd /src \
  && npm install

FROM docker.io/nginx:1.30.6-alpine

COPY ./wwwroot /var/www
# the images the wiki shows when an upload is missing, and for fishbux;
# they seed the uploads volume the first time it's created
COPY ./upload /var/www/upload

# only ship the packages the pages load, not all of node_modules;
# wwwroot/src/js/{basic,dragondrop,load}.js are symlinks into these
COPY --from=npm /src/node_modules/@ruffle-rs/ruffle /var/www/src/node_modules/@ruffle-rs/ruffle
COPY --from=npm /src/node_modules/wetfish-basic/dist /var/www/src/node_modules/wetfish-basic/dist
COPY --from=npm /src/node_modules/dragondrop/dragondrop.js /var/www/src/node_modules/dragondrop/dragondrop.js
COPY --from=npm /src/node_modules/load/load.js /var/www/src/node_modules/load/load.js

COPY ./config/nginx.conf /etc/nginx/conf.d/default.conf

# uploads belong to php's user (fishy, uid 1101), whichever container creates the volume
RUN set -exu \
  && chown -R 1101:1101 /var/www/upload

# taken from nginx dockerfile here
# https://github.com/nginxinc/docker-nginx/blob/fef51235521d1cdf8b05d8cb1378a526d2abf421/stable/alpine/Dockerfile
ENTRYPOINT ["/docker-entrypoint.sh"]
EXPOSE 80
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
