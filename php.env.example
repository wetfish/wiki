# On a server, add-project.sh fills in the database, SITE_URL, and passwords
# as setup.conf says; everything else keeps the value from this file.

# The shared database on a server; for local development, the db service
# in docker-compose.override.yml, which must match mariadb.env
DB_HOSTNAME=db
DB_USERNAME=wiki
DB_DATABASE=wiki
DB_PASSWORD=secret

# The wiki's domain, without https://
SITE_URL=127.0.0.1:2405

# Hostnames that load{} and embed{} may fetch pages from
ALLOWED_EMBEDS='/^.*\.wetfish\.net$/i'

# Used for embedding content from other wiki pages
# This is the nginx service in docker-compose.yml
# If the site is being run without docker, this can be the same as SITE_URL
INTERNAL_HOSTNAME=nginx

LOGIN_PASSWORD=secret
ADMIN_PASSWORD=secret
BAN_PASSWORD=secret

# Regex that skips the captcha on the API, empty for none
CAPTCHA_BYPASS=

# IP patterns banned from editing, passed to json_decode()
# needs to resolve as an array, such as '["127\.0\.0\.1", "^2600:123"]'
BANLIST='[]'
