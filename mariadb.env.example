# local development only, for the db service in docker-compose.override.yml;
# on a server the wiki uses the shared database from wetfish/server
MARIADB_AUTO_UPGRADE=true
MARIADB_ROOT_HOST=%
MARIADB_MYSQL_LOCALHOST_USER=true

MARIADB_ROOT_PASSWORD=mariadb

# must match php.env
MARIADB_DATABASE=wiki
MARIADB_USER=wiki
MARIADB_PASSWORD=secret
